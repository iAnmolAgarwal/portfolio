---
// The page for an address the site does not have, such as a link to one of the
// old site's pages: the top bar as the page has it, and a way back. No script.
//
// It takes the page's whole stylesheet, in the page's order. With only some of
// it, the build would split the shared part off into a file of its own that the
// page loads first, which would change the order its rules apply in.
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/page.css';
import '../styles/tv.css';
import '../styles/rail.css';
import '../styles/cable.css';
import '../styles/mascot.css';
import '../styles/phone.css';

import TopBar from '../components/TopBar.astro';
import { NOT_FOUND, PERSON } from '../data/site';
---

<!doctype html>
<html lang="en" data-stage="done">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`${NOT_FOUND.title} · ${PERSON.name}`}</title>
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#f6f6f3" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="lost">
    <TopBar />
    <main class="lost-main">
      <h2 class="lost-title">{NOT_FOUND.title}</h2>
      <a class="link" href="/">{NOT_FOUND.back}</a>
    </main>
  </body>
</html>

<style>
  /* In the middle of the paper, under the top bar. */
  .lost-main {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: calc(18 * var(--u));
    pointer-events: none;
  }

  .lost-main > * {
    pointer-events: auto;
  }

  .lost-title {
    font-family: var(--serif);
    font-size: max(28px, calc(44 * var(--u)));
    font-weight: 400;
    line-height: 1.1;
  }

  /* On a phone the top bar sits in the column at the top, as on the page. */
  @media (max-width: 820px) and (orientation: portrait) {
    .lost-main {
      gap: 14px;
    }
  }
</style>
