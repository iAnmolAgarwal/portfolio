---
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/page.css';
import '../styles/tv.css';
import '../styles/rail.css';
import '../styles/cable.css';
import '../styles/mascot.css';
import '../styles/phone.css';

import Cable from '../components/Cable.astro';
import Mascot from '../components/Mascot.astro';
import NowPlaying from '../components/NowPlaying.astro';
import Rail from '../components/Rail.astro';
import Television from '../components/Television.astro';
import TopBar from '../components/TopBar.astro';
import { CHANNELS, META } from '../data/site';

// The page is served finished, with the first channel on, so it is complete
// before any script runs and for a visitor who has none.
const first = CHANNELS[0];

// If the page's script has not taken over this long after the head was read, the
// page stops waiting for its opening and shows itself finished.
const RESCUE_MS = 4000;
---

<!doctype html>
<html lang="en" data-stage="done" data-channel={first.number}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{META.title}</title>
    <meta name="description" content={META.description} />
    <meta name="theme-color" content="#f6f6f3" />
    <link rel="canonical" href={META.url} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={META.title} />
    <meta property="og:description" content={META.description} />
    <meta property="og:url" content={META.url} />
    <meta property="og:image" content={META.image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={META.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={META.title} />
    <meta name="twitter:description" content={META.description} />
    <meta name="twitter:image" content={META.image} />
    {
      /*
       * Before the first paint. Where the opening will play, the page starts dark
       * (`off`), so the finished page never flashes up ahead of it. A visitor who
       * asked for less motion keeps the finished page and is marked `data-reduced`.
       */
    }
    <script is:inline define:vars={{ RESCUE_MS }}>
      (function (root) {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
          root.setAttribute('data-reduced', '');
          return;
        }
        root.setAttribute('data-stage', 'off');
        window.openingRescue = setTimeout(function () {
          root.setAttribute('data-stage', 'done');
        }, RESCUE_MS);
      })(document.documentElement);
    </script>
  </head>
  <body>
    <TopBar />
    <main class="stage">
      <div class="set">
        <Mascot />
        <Television channel={first} />
        <Cable />
      </div>
      <NowPlaying channel={first} />
    </main>
    <Rail />
    <script>import '../scripts/main.ts';</script>
  </body>
</html>
