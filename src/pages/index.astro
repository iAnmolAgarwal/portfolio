---
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Thwip from '../components/Thwip.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { person, projects, experience, education, cp, stack, links, commands } from '../data/portfolio';

const BOOT_CMD = 'claude "who is anmol agarwal"';
const title = 'Anmol Agarwal — CS undergrad · trading systems, AI agents, embedded';
const description = person.tagline;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <div class="wrap">
      <main class="win" aria-label="terminal session">
        <Thwip />

        <div class="transcript" id="transcript">
          <!-- ❯ command -->
          <div class="line">
            <span class="prompt-glyph" aria-hidden="true">❯</span>
            <span id="typed" data-cmd={BOOT_CMD}>{BOOT_CMD}</span>
          </div>

          <!-- ✻ thinking (JS-only) -->
          <div class="line" id="think" hidden aria-live="polite">
            <span class="spark" id="spark" aria-hidden="true">✻</span>
            <span class="muted" id="think-text">Pondering…</span>
          </div>

          <!-- tool calls -->
          <div class="tool pending" data-stream data-pace="fast"><span class="bullet" aria-hidden="true">●</span><span>Read(about/anmol.md)</span></div>
          <div class="result pending" data-stream data-pace="fast">Read 14 lines</div>
          <div class="tool pending" data-stream data-pace="fast"><span class="bullet" aria-hidden="true">●</span><span>Glob(projects/**)</span></div>
          <div class="result pending" data-stream data-pace="fast">Found {projects.length} projects</div>
          <div class="tool pending" data-stream data-pace="fast"><span class="bullet" aria-hidden="true">●</span><span>Read(cp/ratings.json)</span></div>
          <div class="result pending" data-stream data-pace="fast">Read 1 file</div>
          <div class="line muted pending" data-stream data-pace="fast" style="margin-top:6px">Called Read 2 times, Glob once — 0 shell commands</div>

          <!-- the answer = the portfolio -->
          <div class="answer" id="answer">
            <p class="lede pending" id="whoami" data-stream data-type>
              <strong>{person.name}</strong> {person.lede}
            </p>
            <p class="pending muted" data-stream style="margin-top:8px">Now: {person.now}</p>
            <p class="pending" data-stream style="margin-top:14px">Here's the full picture:</p>

            <section class="section" id="projects" aria-labelledby="h-projects">
              <h2 class="h pending" id="h-projects" data-stream>projects <span class="cmd">/projects</span></h2>
              {projects.map((p) => <ProjectCard p={p} />)}
            </section>

            <section class="section" id="experience" aria-labelledby="h-experience">
              <h2 class="h pending" id="h-experience" data-stream>experience <span class="cmd">/experience</span></h2>
              <dl class="kv">
                {experience.map((e) => (
                  <>
                    <dt class="pending" data-stream>{e.when}</dt>
                    <dd class="pending" data-stream>
                      <strong>{e.role}</strong> · {e.org}
                      <ul class="bullets">{e.lines.map((l) => <li>{l}</li>)}</ul>
                      {e.link && <div class="links"><a href={e.link.href} target="_blank" rel="noopener">{e.link.label}</a></div>}
                    </dd>
                  </>
                ))}
                <dt class="pending" data-stream>{education.when}</dt>
                <dd class="pending" data-stream>
                  <strong>{education.degree}</strong> · {education.school}
                  <ul class="bullets">{education.lines.map((l) => <li>{l}</li>)}</ul>
                </dd>
              </dl>
            </section>

            <section class="section" id="cp" aria-labelledby="h-cp">
              <h2 class="h pending" id="h-cp" data-stream>competitive programming <span class="cmd">/cp</span></h2>
              <ul class="bullets">{cp.map((l) => <li class="pending" data-stream>{l}</li>)}</ul>
            </section>

            <section class="section" id="stack" aria-labelledby="h-stack">
              <h2 class="h pending" id="h-stack" data-stream>stack <span class="cmd">/stack</span></h2>
              <dl class="kv">
                {Object.entries(stack).map(([k, v]) => (
                  <>
                    <dt class="pending" data-stream>{k}</dt>
                    <dd class="pending" data-stream><div class="flags">{v.map((f) => <span class="flag">--{f}</span>)}</div></dd>
                  </>
                ))}
              </dl>
            </section>

            <section class="section" id="contact" aria-labelledby="h-contact">
              <h2 class="h pending" id="h-contact" data-stream>contact <span class="cmd">/contact</span></h2>
              <dl class="kv">
                {links.map((l) => (
                  <>
                    <dt class="pending" data-stream>{l.label}</dt>
                    <dd class="pending" data-stream><a href={l.href} target={l.href.startsWith('mailto') ? undefined : '_blank'} rel="noopener">{l.display}</a></dd>
                  </>
                ))}
              </dl>
              <p class="pending muted" data-stream style="margin-top:10px">{person.location} · {person.availability}.</p>
            </section>
          </div>

          <div class="worked pending" data-stream><span class="spark" aria-hidden="true">✻</span><span id="worked-text">Worked for 4s</span></div>
          <div class="recap pending" data-stream>※ recap: builds things that must not fail silently. <b>{person.availability}</b>.</div>

          <!-- command palette -->
          <div class="palette pending" id="palette" data-stream data-pace="fast">
            <nav class="chips" aria-label="commands">
              <span class="label">commands:</span>
              {commands.filter((c) => c.name !== '/clear').map((c) => (
                <a href={c.name === '/resume' ? person.resumePath : c.name === '/help' ? '#palette' : c.name === '/whoami' ? '#whoami' : `#${c.name.slice(1)}`} data-cmd={c.name} target={c.name === '/resume' ? '_blank' : undefined}>{c.name}</a>
              ))}
            </nav>
            <div class="log" id="log" aria-live="polite"></div>
            <form class="cmdline" id="cmdform" autocomplete="off">
              <label for="cmd" class="prompt-glyph" aria-label="command prompt">❯</label>
              <span class="ghost" id="ghost" aria-hidden="true"></span>
              <input id="cmd" name="cmd" type="text" spellcheck="false" autocapitalize="off" autocorrect="off" placeholder="type / for commands" aria-describedby="cmd-hint" />
              <span class="hint" id="cmd-hint">⇥ complete · ↵ run · esc clear</span>
            </form>
          </div>
        </div>
      </main>
      <button class="skip" id="skip" type="button" hidden>press any key to skip ↵</button>
    </div>

    <footer class="statusbar">
      <span><span class="mode">▶▶ {person.availability}</span> <span class="desk">(shift+tab to cycle · / for commands)</span></span>
      <span><span class="idle-spark" aria-hidden="true">✻</span>{person.handle}</span>
    </footer>

    <script>
      import { startSession } from '../scripts/session';
      startSession();
    </script>
  </body>
</html>
