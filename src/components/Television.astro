---
// The set: antenna, body, screen, the panel with the channel dial, two legs, and
// the handwritten note beside the dial. Every channel's clip is on the screen and
// the one marked `data-on` is the one that shows. Only that one's clip is fetched
// with the page; the others wait, behind their posters, until the set is on.
import { CHANNELS, NOTES, type Channel } from '../data/site';

interface Props {
  channel: Channel;
}

const { channel } = Astro.props;

// Where each channel's number sits round the dial, in the dial drawing's own units.
const NUMBER_AT = [
  { x: 17, y: 22 },
  { x: 50, y: 8 },
  { x: 83, y: 22 },
];
---

<div class="tv" data-tv>
  <div class="antenna"><i></i><i></i></div>
  <div class="tv-body">
    <div class="screen" data-screen>
      <div class="media">
        {
          CHANNELS.map((each) => (
            <video
              src={each.video}
              poster={each.poster}
              muted
              loop
              playsinline
              preload={each.number === channel.number ? 'metadata' : 'none'}
              data-on={each.number === channel.number ? '' : undefined}
            />
          ))
        }
      </div>
      <div class="static" data-static></div>
      <div class="crt"></div>
      <div class="osd" data-osd aria-hidden="true">CH {channel.number}</div>
    </div>
    <div class="panel">
      <div class="dial">
        <svg viewBox="0 0 100 100" aria-hidden="true">
          <circle class="dial-ring" data-ring cx="50" cy="50" r="36" pathLength="100"></circle>
          {
            CHANNELS.map((each, index) => (
              <text
                class="dial-num"
                data-n={each.number}
                x={NUMBER_AT[index].x}
                y={NUMBER_AT[index].y}
                text-anchor="middle"
              >
                {each.number}
              </text>
            ))
          }
        </svg>
        <div
          class="knob"
          data-dial
          role="slider"
          tabindex="0"
          aria-label="Channel"
          aria-valuemin="1"
          aria-valuemax={CHANNELS.length}
          aria-valuenow={channel.number}
        >
          <span></span>
        </div>
      </div>
      <div class="knob small"><span></span></div>
      <div class="grille"></div>
    </div>
  </div>
  <div class="legs"><i></i><i></i></div>
  <div class="hint" data-hint>
    <svg
      viewBox="0 0 64 34"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M60 30 C 44 30, 22 26, 6 8"></path>
      <path d="M5 19 L5 7 L17 9"></path>
    </svg>
    <em>{NOTES.dial}</em>
  </div>
</div>
